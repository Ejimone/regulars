# Copy to .env and fill in. The API refuses to boot with any of these missing.

# GroqCloud API key — create one free at https://console.groq.com/keys
GROQ_API_KEY=

# Postgres DSN for running the API natively (docker compose overrides this
# internally with the `db` service hostname; host port is 5433 to avoid
# colliding with a local postgres on 5432)
DATABASE_URL=postgresql+psycopg://regulars:regulars@localhost:5433/regulars

# Origin the browser app runs on (CORS allowlist)
WEB_ORIGIN=http://localhost:3000

# Where the browser app finds the API
NEXT_PUBLIC_API_URL=http://localhost:8000
